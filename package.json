{
  "name": "onlineriskgame",
  "version": "0.0.1",
  "private": true,
  "description": "Domination: World Conquest -- a turn-based world-conquest strategy game",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run --passWithNoTests",
    "test:unit:watch": "vitest",
    "build:vendor": "npm run build:vendor:cannon && npm run build:vendor:three && npm run build:vendor:buffer-utils",
    "build:vendor:cannon": "webpack --config webpack-cannon.config.cjs",
    "build:vendor:three": "webpack --config webpack-three.config.cjs",
    "build:vendor:buffer-utils": "webpack --config webpack-buffer-utils.config.cjs",
    "test:e2e": "node tests/run-e2e.mjs",
    "test:e2e:category": "node tests/run-e2e.mjs",
    "test:e2e:categories": "node tests/run-e2e.mjs --list",
    "test:e2e:headed": "node tests/run-e2e.mjs --headed",
    "test:e2e:slow": "node tests/run-e2e.mjs --headed --slow",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:report": "playwright show-report test-reports/runs/adhoc/html",
    "build:adjacency": "node tools/build-adjacency.mjs",
    "build:adjacency:check": "node tools/build-adjacency.mjs --check",
    "build:areas": "node tools/precompute-areas.mjs",
    "build:areas:check": "node tools/precompute-areas.mjs --check",
    "build:music": "node tools/build-music-manifest.mjs",
    "build:music:check": "node tools/build-music-manifest.mjs --check",
    "build:data": "npm run build:adjacency && npm run build:areas && npm run build:music",
    "test:e2e:perf": "node tests/run-e2e.mjs bootstrap"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/leighhobson89/OnlineRiskGame.git"
  },
  "keywords": [
    "risk",
    "strategy",
    "turn-based",
    "html",
    "css",
    "javascript"
  ],
  "author": "Leigh Hobson",
  "license": "GPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/leighhobson89/OnlineRiskGame/issues"
  },
  "homepage": "https://github.com/leighhobson89/OnlineRiskGame#readme",
  "devDependencies": {
    "@babel/preset-env": "^7.28.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "babel-loader": "^9.1.3",
    "cannon-es": "^0.20.0",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "three": "^0.154.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "webpack": "^5.88.2",
    "webpack-cli": "^5.1.4"
  }
}
